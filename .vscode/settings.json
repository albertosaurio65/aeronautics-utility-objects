{
    "java.configuration.updateBuildConfiguration": "interactive",
    "files.encoding": "utf8",
    "terminal.integrated.env.windows": {
        "DEBUG": null,
        "PYTHONIOENCODING": "utf-8"
    },
    "terminal.integrated.profiles.windows": {
        "PowerShell UTF-8": {
            "source": "PowerShell",
            "args": [
                "-NoExit",
                "-Command",
                "chcp 65001 | Out-Null; [Console]::OutputEncoding = [System.Text.UTF8Encoding]::new(); $OutputEncoding = [System.Text.UTF8Encoding]::new(); Remove-Item Env:DEBUG -ErrorAction SilentlyContinue"
            ]
        }
    },
    "terminal.integrated.defaultProfile.windows": "PowerShell UTF-8"
}
